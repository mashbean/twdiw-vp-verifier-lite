{
  "name": "twdiw-vp-verifier-lite",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "OIDC4VP verifier for Taiwan TWDIW SD-JWT-VC and 有備而來 vc+moica credentials on Cloudflare Workers.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashbean/twdiw-vp-verifier-lite.git"
  },
  "homepage": "https://verifier.mashbean.net",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:mashbean": "wrangler deploy --config wrangler.mashbean.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "deploy:mashbean:worker-only": "wrangler deploy --config wrangler.mashbean.jsonc --containers-rollout=none"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@peculiar/x509": "^2.0.0",
    "@sd-jwt/core": "^0.10.0",
    "@sd-jwt/sd-jwt-vc": "^0.10.0",
    "jose": "^5.9.6",
    "qrcode-generator": "^1.4.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode-generator": "^0.0.16",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
