{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep this production Worker name to preserve the existing Durable Object namespaces and verifier did:key.
  "name": "mashbean-vp-verifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "fd8f8ed12dcdfd03ad171a3a74bc712a",
  "routes": [{ "pattern": "verifier.mashbean.net", "custom_domain": true }],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false, "persist": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "PresentationSession" },
      { "name": "IDENTITY", "class_name": "VerifierIdentity" },
      { "name": "ZKP_SESSIONS", "class_name": "ZkpSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresentationSession"] },
    { "tag": "v2", "new_sqlite_classes": ["VerifierIdentity"] },
    { "tag": "v3", "new_sqlite_classes": ["ZkpSession"] }
  ],
  "vars": {
    "OFFICIAL_TRUST_REGISTRY_URL": "https://frontend.wallet.gov.tw/api/did",
    "VERIFIER_ORIGIN": "https://verifier.mashbean.net"
  }
}
