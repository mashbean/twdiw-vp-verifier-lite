{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep this production Worker name to preserve the existing Durable Object namespaces and verifier did:key.
  "name": "mashbean-vp-verifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "fd8f8ed12dcdfd03ad171a3a74bc712a",
  "routes": [{ "pattern": "verifier.mashbean.net", "custom_domain": true }],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false, "persist": false }
  },
  // The zero-knowledge verifier runs as a container because its Prepare
  // verifying key is 412 MB and a Worker isolate has 128 MiB. Containers need
  // the Workers Paid plan, so they are declared only here, in the demo
  // deployment — wrangler.jsonc stays deployable on the free plan and uses the
  // ZKP_VERIFIER_URL secret instead.
  //
  // The image is built from its Dockerfile by whoever runs `wrangler deploy`.
  // That is Workers Builds: its environment can run Dockerfile builds, so the
  // image is built, pushed to Cloudflare's registry and rolled out on a push to
  // the production branch, and no laptop needs Docker. Only a full
  // `wrangler deploy` publishes an image — the `wrangler versions upload` that
  // Workers Builds runs on non-production branches uploads Worker code alone.
  "containers": [
    {
      "name": "openac-age-verifier",
      "class_name": "ZkpVerifierContainer",
      "image": "./native/openac-age-verifier/Dockerfile",
      "image_build_context": "./native/openac-age-verifier",
      // 4 GiB. The service holds 429 MB once its keys are loaded; the peak
      // during verification has not been measured yet, so this leaves room.
      // Drop to "basic" (1 GiB) once a real proof has been checked and the
      // peak is known.
      "instance_type": "standard-1",
      // A ceiling on cost as much as on load: each awake instance bills its
      // provisioned memory for as long as it stays awake.
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "PresentationSession" },
      { "name": "IDENTITY", "class_name": "VerifierIdentity" },
      { "name": "ZKP_SESSIONS", "class_name": "ZkpSession" },
      { "name": "ZKP_CONTAINER", "class_name": "ZkpVerifierContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresentationSession"] },
    { "tag": "v2", "new_sqlite_classes": ["VerifierIdentity"] },
    { "tag": "v3", "new_sqlite_classes": ["ZkpSession"] },
    { "tag": "v4", "new_sqlite_classes": ["ZkpVerifierContainer"] }
  ],
  "vars": {
    "OFFICIAL_TRUST_REGISTRY_URL": "https://frontend.wallet.gov.tw/api/did",
    "VERIFIER_ORIGIN": "https://verifier.mashbean.net"
  }
}
